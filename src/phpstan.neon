includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Tests are executed by Pest rather than analysed: Pest closures forward HTTP
    # helpers through __call, which PHPStan cannot resolve without suppressing the
    # error. Correctness of tests is covered by running them, not by reading types.
    paths:
        - app
        - config
        - database
        - routes

    level: 6

    # Models declare casts in casts() methods rather than $casts properties.
    # Enabling this lets Larastan infer the real attribute types (Carbon, array, etc.).
    parseModelCastsMethod: true

    excludePaths:
        - app/Providers/*
