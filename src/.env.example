APP_NAME=HoopFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Authentication hardening
DEMO_ACCOUNTS=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=60
AUTH_SESSION_IDLE_TIMEOUT=60
PASSWORD_RESET_EXPIRE=60
PASSWORD_RESET_THROTTLE=60

# Rate limiting
RATE_LIMIT_WEB_MAX_ATTEMPTS=120
RATE_LIMIT_LIVEWIRE_MAX_ATTEMPTS=240
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=60
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=20
RATE_LIMIT_PASSWORD_RESET_PER_EMAIL_PER_MINUTE=3
RATE_LIMIT_PASSWORD_RESET_SUBMIT_PER_MINUTE=10
RATE_LIMIT_API_MAX_ATTEMPTS=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: AI announcement drafting (Google Gemini API)
# Create a key in Google AI Studio: https://aistudio.google.com/apikey
# Leave blank to hide the drafting card and keep the manual composer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DB_READ_HOST=127.0.0.1
DB_READ_PORT=5432
DB_WRITE_HOST=127.0.0.1
DB_WRITE_PORT=5432
DB_STICKY=true
# DB_REPLICA=127.0.0.1

# Production email - Brevo SMTP relay (free plan: 300 emails/day)
# 1. Verify a sender in Brevo under Senders, Domains & Dedicated IPs.
# 2. Open SMTP & API -> SMTP and copy the Login and an SMTP key.
#    The Login is often a generated address such as 123456001@smtp-brevo.com,
#    not your account email. SMTP keys start with xsmtpsib-.
# 3. Replace the placeholders and uncomment.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=your-brevo-smtp-login
# MAIL_PASSWORD=your-brevo-smtp-key
# MAIL_FROM_ADDRESS=no-reply@your-verified-domain.com
# MAIL_FROM_NAME="${APP_NAME}"

# Fallback: Mailtrap Email Sending (requires a verified sending domain)
# MAIL_MAILER=smtp
# MAIL_HOST=live.smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=api
# MAIL_PASSWORD=your-mailtrap-api-token
# MAIL_FROM_ADDRESS=no-reply@your-verified-domain.com
# MAIL_FROM_NAME="${APP_NAME}"
